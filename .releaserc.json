{
	"branches": ["main"],
	"tagFormat": "${version}",
	"plugins": [
		"@semantic-release/commit-analyzer",
		"@semantic-release/release-notes-generator",
		["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
		["@semantic-release/npm", { "npmPublish": false }],
		[
			"@semantic-release/exec",
			{
				"prepareCmd": "node scripts/update-obsidian-versions.mjs ${nextRelease.version}"
			}
		],
		[
			"@semantic-release/git",
			{
				"assets": ["package.json", "package-lock.json", "manifest.json", "versions.json", "CHANGELOG.md"],
				"message": "chore(release): ${nextRelease.version} [skip ci]"
			}
		],
		[
			"@semantic-release/github",
			{
				"assets": [
					{ "path": "main.js", "label": "main.js" },
					{ "path": "manifest.json", "label": "manifest.json" },
					{ "path": "styles.css", "label": "styles.css" }
				]
			}
		]
	]
}
