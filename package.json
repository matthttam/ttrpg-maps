{
  "name": "obsidian-ttrpg-maps",
  "version": "0.1.0",
  "description": "Interactive TTRPG map plugin for Obsidian with markers, templates, and distance tools",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "ttrpg",
    "maps",
    "rpg"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  }
}
