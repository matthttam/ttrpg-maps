{
  "name": "obsidian-ttrpg-maps",
  "version": "1.0.5",
  "description": "Render interactive TTRPG maps from code blocks with markers, templates, and distance measurement tools.",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/matthttam/ttrpg-maps.git"
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "dev": "node scripts/build-icons.mjs && node esbuild.config.mjs",
    "build": "node scripts/build-icons.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "ttrpg",
    "maps",
    "rpg"
  ],
  "author": "matthttam",
  "license": "MIT",
  "devDependencies": {
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/game-icons": "^1.2.3",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "jsdom": "^29.0.1",
    "obsidian": "latest",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
