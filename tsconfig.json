{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"strict": true,
		"importHelpers": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ESNext"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
